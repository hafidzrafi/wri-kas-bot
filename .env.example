# WhatsApp Configuration (Digits only, e.g. 628xxxxxxxxxx)
BENDAHARA_NUMBER=6281100000099
BOT_NUMBER=6281100000002
BENDAHARA_JID=6281100000099@s.whatsapp.net
WEBHOOK_SECRET=

# Multimodal AI (Receipt Metadata Extraction)
GEMINI_API_KEY=your_gemini_api_key_here
