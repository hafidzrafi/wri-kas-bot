# Evolution API (WhatsApp Gateway)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=your_evolution_api_key_here
BOT_INSTANCE_NAME=Bot WRI

# WhatsApp Configuration (Digits only, e.g. 628xxxxxxxxxx)
BENDAHARA_NUMBER=6281100000001
BOT_NUMBER=6281100000002

# Google Workspace Integration
SPREADSHEET_ID=your_google_spreadsheet_id_here
DRIVE_PROOF_FOLDER_ID=your_google_drive_folder_id_here
QRIS_FILE_URL=https://example.com/qris.jpg
GOOGLE_SERVICE_ACCOUNT_JSON=service_account.json
GOOGLE_DRIVE_TOKEN_JSON=

# Local Storage (SQLite WAL & Media)
DATABASE_PATH=data/kas_wri.db
RECEIPTS_DIR=data/receipts

# Multimodal AI (Receipt Metadata Extraction)
GEMINI_API_KEY=your_gemini_api_key_here

# Monitoring & Alerting (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Webhook Security (Optional)
WEBHOOK_SECRET=
